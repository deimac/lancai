# ==============================
# Supabase / Banco de Dados
# ==============================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# String de conexão direta do Postgres (usada pelo Drizzle), disponível no painel do Supabase
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# ==============================
# apps/api
# ==============================
PORTA_API=3333
URL_WEB=http://localhost:5173
# Chave AES-256 (32 bytes em base64) para cifrar número/validade/CVV dos cartões.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CARTAO_DADOS_KEY=

# ==============================
# Provedores de IA (OrquestradorIA)
# Preencha as chaves dos provedores que você possui.
# ==============================

# Groq é sempre o 1º. Gemini só entra com LLM_FALLBACK_GEMINI=true.
LLM_PROVEDOR_PADRAO=groq
LLM_ORDEM_FALLBACK=groq
# LLM_FALLBACK_GEMINI=true
# LLM_ORDEM_FALLBACK=groq,gemini
# Timeout cloud (ms); Ollama em CPU precisa de mais folga
LLM_TIMEOUT_MS=20000
LLM_TIMEOUT_OLLAMA_MS=90000
# Health-check periódico do orquestrador (pula provedor morto sem gastar timeout)
# LLM_HEALTH_TTL_MS=45000
# LLM_HEALTH_PING_MS=2500

GEMINI_API_KEY=
# Preferir gemini-2.0-flash (evitar variantes "thinking"/3.x lentas no chat)
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
# Extração / slot-filling (maior)
# GROQ_MODEL=openai/gpt-oss-120b
# Classificação de ramo (menor, mais barato)
# GROQ_MODEL_CLASSIFICAR=openai/gpt-oss-20b
# Whisper (áudio WhatsApp)
# GROQ_MODEL_WHISPER=whisper-large-v3-turbo
# Visão comprovantes (quando sem Gemini)
# GROQ_MODEL_VISION=meta-llama/llama-4-scout-17b-16e-instruct
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Ollama (opcional, local/dev). Isolado na VPS — não chama sem este flag.
OLLAMA_HABILITADO=false
# brew install ollama && ollama pull qwen2.5:3b-instruct && ollama serve
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:3b-instruct
# LLM_ORDEM_FALLBACK=groq,gemini,ollama

# Modelos opcionais
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_MODEL_CLASSIFICAR=openai/gpt-oss-20b
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini

# ==============================
# Evolution API (WhatsApp) — @lancai/evolution
# Webhook receptor: POST /api/webhooks/evolution
# ==============================
EVOLUTION_URL=https://evolution.xploreia.com
EVOLUTION_GLOBAL_API_KEY=
EVOLUTION_INSTANCE=Lancai
# Opcional: token da instância (Evolution pode enviar este valor em body.apikey)
EVOLUTION_INSTANCE_API_KEY=
# Número do WhatsApp do LançAI (instância que RECEBE mensagens) — só dígitos
# Não é o número do cliente; clientes autorizados vão em usuario.whatsapp_numero
WHATSAPP_NUMERO_LANCAI=5511992138303
# Email do usuário seed (db:seed)
# USUARIO_SEED_EMAIL=

# Cron Coolify: POST /cron/recorrencias com Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# ==============================
# Open Finance
# ==============================
# Vazio desliga a Fonte: POST /api/webhooks/open-finance responde 503.
# Valores com adaptador: pluggy (real) e duble (provedor de mentira, em memória).
# Com duble: /conexoes cria conexão e sincroniza lote sem widget nem túnel
# (checklist em docs/15-OPERACAO.md). Não fecha a F2 — sandbox Pluggy ainda falta.
OPEN_FINANCE_PROVEDOR=

# Segredo esperado no header X-Lancai-Webhook. Vazio mantém a rota fechada,
# mesmo com provedor ativo.
OPEN_FINANCE_WEBHOOK_SEGREDO=

# URL pública do nosso webhook, repassada ao provedor ao criar o token de
# conexão. Precisa ser HTTPS; localhost não é aceito, use um túnel.
# Preferido para o Dashboard Pluggy (liberação de dados reais):
#   https://api.lancai.xploreia.com/api/webhooks/pluggy
# Alias canônico (mesmo handler): /api/webhooks/open-finance
OPEN_FINANCE_WEBHOOK_URL=

# Dias que o payload bruto de open_finance_evento fica intacto após processar
# com sucesso. Depois o cron /cron/open-finance-retencao troca por stub (LGPD).
# A linha permanece por causa da idempotência. Padrão: 30.
OPEN_FINANCE_RETENCAO_DIAS=30

# Cron GET /cron/open-finance-importar-historico: só importa conexões com
# ultimoSyncEm nulo ou mais antigo que N minutos (padrão 240 = 4 h).
OPEN_FINANCE_STALE_AFTER_MINUTES=240

# Janela dateFrom do GET de extrato no cron (dias). Primeira sync (nunca
# sincronizou) ainda usa 365. “Atualizar agora” na UI também usa 365.
OPEN_FINANCE_SYNC_LOOKBACK_DAYS=14


# Credenciais do provedor, obrigatórias quando OPEN_FINANCE_PROVEDOR=pluggy.
# São elas que leem dado financeiro: nunca vão para o frontend nem para log.
# Connect Token usa clientUserId = usuarioId LançAI (não workspace).
# Sandbox gratuito (dashboard Pluggy → API Keys). Conector “Pluggy Bank”:
# user-ok / password-ok, MFA 123456. Ver docs/13-OPEN_FINANCE.md §8.8 e
# docs/15-OPERACAO.md (checklist sandbox / Coolify + Nubank real).
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=


# Assistente 2.0 V2 (legado permanece até ASSISTENTE_V2_ASSISTANT=true)
# ASSISTENTE_V2_SESSION=false
# ASSISTENTE_V2_PARSER=false
# ASSISTENTE_V2_RESOLVER=false
# ASSISTENTE_V2_POLICY=false
# ASSISTENTE_V2_EXECUTE=false
# ASSISTENTE_V2_CORE=false
# ASSISTENTE_V2_ASSISTANT=false
# ASSISTENTE_V2_SHADOW=false

# AssistenteCore V3 (default off). Shadow compara sem gravar sessão e sem marcar messageId.
# Não ligar ASSISTENTE_V3_ASSISTANT=true em produção nesta entrega.
# ASSISTENTE_V3_ASSISTANT=false
# ASSISTENTE_V3_SHADOW=true

# ==============================
# apps/web
# ==============================
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:3333
# true = lista conectores sandbox (banco de teste) no widget. Sem isto o
# Connect em DEV não liga sandbox.
# VITE_OPEN_FINANCE_INCLUDE_SANDBOX=true
