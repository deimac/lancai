# ==============================
# Supabase / Banco de Dados
# ==============================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# String de conexão direta do Postgres (usada pelo Drizzle), disponível no painel do Supabase
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# ==============================
# apps/api
# ==============================
PORTA_API=3333
URL_WEB=http://localhost:5173

# ==============================
# Provedores de IA (OrquestradorIA)
# Preencha as chaves dos provedores que você possui.
# ==============================

# Provedor usado por padrão
LLM_PROVEDOR_PADRAO=gemini
# Ordem de fallback caso o provedor padrão falhe ou atinja limite (separado por vírgula)
LLM_ORDEM_FALLBACK=gemini,groq,openrouter,ollama,openai

GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Endpoint local do Ollama (não exige chave)
OLLAMA_BASE_URL=http://localhost:11434

# ==============================
# apps/web
# ==============================
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:3333
